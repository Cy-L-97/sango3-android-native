# ===== 本地备份（内含 .git 镜像，绝不入库）=====
.workbuddy/git-backup-*/

# ===== 临时/探针文件 =====
.workbuddy/probe*.txt
.workbuddy/probe*.py
.workbuddy/sample/
.workbuddy/gallery/
.workbuddy/data/
.workbuddy/script/
.workbuddy/png/
.workbuddy/downloads/
# 渲染产物一律不入库（4K 单张 2MB+）；用 tools/render_scene.py / render_font_preview.py 随时重生
.workbuddy/render/
*.tmp
*.log

# ===== 游戏原版素材与版权文件（严禁入库，各机器从本地正版游戏读取）=====
assets/original/
assets/hd/
game/
*.pak
*.pck
*.sav
*.shp
*.res

# ===== 编译产物与二进制 =====
build/
out/
bin/
obj/
__pycache__/
*.pyc
*.pyo
*.exe
*.dll
*.so
*.apk
*.aab

# ===== 第三方依赖（体积大，由 tools/fetch_*.py 自动获取，不入库）=====
third_party/

# ===== IDE / 工具链缓存 =====
.vs/
.vscode/
.idea/
*.user
CMakeCache.txt
CMakeFiles/
.cxx/
.gradle/
local.properties
