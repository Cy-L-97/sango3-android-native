# ===== 本地备份（内含 .git 镜像，绝不入库）=====
.workbuddy/git-backup-*/

# ===== 凭据与密钥（严禁入库）=====
# 私钥、证书、令牌、环境变量文件——一旦入库即等于泄露
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.pem
*.key
*.pfx
*.p12
*.ppk
*.jks
*.keystore
.env
.env.*
.netrc
_netrc
# 常见凭据文件名。注意：不要用 *secret* / *credential* 这类过宽的通配，
# 会误伤正常脚本（例如 tools/check_secrets.py 就会被 *secret* 命中）
credentials.json
credentials.yaml
credentials.yml
secrets.json
secrets.yaml
secrets.yml
secrets.env
*credentials*.json
*credential*.env
*secret*.json
*secret*.yaml
*secret*.yml
*secret*.env
*token*.json

# 本地敏感词表：内含个人姓名等标识，只在本机存在，严禁入库
.workbuddy/secret-denylist.txt

# ===== 临时/探针文件 =====
.workbuddy/probe*.txt
.workbuddy/probe*.py
# 验证证据（C 探针输出/对照报告等一次性产物，必要时随时重跑验证脚本重生）
.workbuddy/evidence/
# 工具链/安装器输出的原始日志（可能含本机路径），不入库
.workbuddy/*_stdout.txt
.workbuddy/*_stderr.txt
.workbuddy/sample/
.workbuddy/gallery/
.workbuddy/data/
.workbuddy/script/
.workbuddy/png/
.workbuddy/downloads/
# 渲染产物一律不入库（4K 单张 2MB+）；用 tools/render_scene.py / render_font_preview.py 随时重生
.workbuddy/render/
*.tmp
*.log

# ===== 游戏原版素材与版权文件（严禁入库，各机器从本地正版游戏读取）=====
assets/original/
assets/hd/
game/
*.pak
*.pck
*.sav
*.shp
*.res

# ===== 但资源图（用于文档/验收）要保留 =====
!*.png
!*.webp

# ===== 编译产物与二进制 =====
build/
out/
bin/
obj/
__pycache__/
*.pyc
*.pyo
*.exe
*.dll
*.so
*.apk
*.aab

# ===== 第三方依赖（体积大，由 tools/fetch_*.py 自动获取，不入库）=====
third_party/

# ===== IDE / 工具链缓存 =====
.vs/
.vscode/
.idea/
*.user
CMakeCache.txt
CMakeFiles/
.cxx/
.gradle/
local.properties
